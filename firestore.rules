rules_version = '2';

// BESOUL Suite — Firestore Security Rules
// ESTADO (2026-09-17, HARDENING-PRE-BASELINE-v3.2.1): el resto de este archivo (items 1-6 de
// abajo, ya vigentes en producción) fue confirmado LIVE por el usuario directamente en Firebase
// Console antes de este cambio -- coincidía exactamente con este archivo salvo el bloque
// besoulSuite/agenda, que hasta ahora usaba isActiveUser() sin aislamiento de escritura por
// trainerKey (item 5). Ese bloque queda descrito arriba, en el propio match /besoulSuite/{docId},
// como "FASE 2 activada" -- ver ese comentario para el detalle completo, el backup exacto (SHA256)
// y la evidencia de Emulator Suite que precedió al despliegue.
//
// Cambios respecto a las reglas documentadas en SECURITY_RULES.md
// (última actualización 2026-08-26):
//   1. NUEVO: match /besoulSolicitudesEliminacion/{solicitudId} — hoy cae
//      en el catch-all deny-all, bloqueando por completo el flujo de baja
//      segura de clientes ya implementado en agenda.html.
//   2. besoulPublicClients: create/update ahora exigen ownership por
//      trainerKey (antes cualquier usuario activo podía tocar el enlace
//      público de cualquier otro entrenador).
//   3. OPCIONAL / FASE 2, comentado por defecto: aislamiento por trainerKey
//      dentro de besoulSuite/agenda. Solo activar después de validar en
//      producción, durante unos días, que la escritura dirigida por
//      trainerKey (merge:true) desplegada en el código (commit
//      "fix: prevent concurrent agenda overwrites") funciona sin errores —
//      ver BESOUL_WORK_STATE.md, sección FASE 3.
//   4. NUEVO (auditoría Reservas, 2026-09-02): besoulReservas.create ahora
//      valida que token/clientId/trainerKey correspondan realmente a un
//      besoulPublicClients/{token} real, no solo que tengan la forma
//      correcta — antes cualquiera con CUALQUIER token válido de un
//      entrenador podía escribir una reserva con el clientId de OTRO
//      cliente del mismo entrenador (besoulPublicClients permite "get"
//      público). Ver BESOUL_WORK_STATE.md, sección Reservas.
//   5. besoulSuite/agenda: signedIn() -> isActiveUser() (revisión final de
//      seguridad, 2026-09-02). signedIn() solo comprueba autenticación/email,
//      no el perfil en besoulUsers -- un usuario autenticado pero marcado
//      activo:false conservaba acceso de lectura/escritura al documento
//      Agenda completo. No rompe ningún flujo real (agenda.html y el único
//      otro escritor, crm.html/convertirLeadEnCliente, ya exigen perfil
//      activo a nivel de aplicación antes de dejar operar).
//      ACTUALIZACIÓN (2026-09-17): el bloque FASE 2 (aislamiento de
//      ESCRITURA por trainerKey) que en esta línea seguía sin activar ya
//      está activo -- ver el comentario dentro de match /besoulSuite/{docId}.
//   6. NUEVO (buzón/notificaciones por PT, 2026-09-03): match
//      /besoulNotifications/{notifId} — colección independiente, fuera del
//      documento monolítico de agenda. Lectura solo por el propio trainerKey
//      destinatario o admin; create permitido a cualquier usuario activo
//      (necesario para que, p.ej., un admin resolviendo una solicitud pueda
//      notificar a OTRO trainerKey; sin datos sensibles en el esquema);
//      update restringido por whitelist a read/readAt únicamente; sin
//      delete. Hoy esta colección cae en el catch-all deny-all si no se
//      despliega esta propuesta.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function getProfile() {
      return get(/databases/$(database)/documents/besoulUsers/$(request.auth.token.email));
    }

    function userProfileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/besoulUsers/$(request.auth.token.email));
    }

    function isActiveUser() {
      return userProfileExists()
        && getProfile().data.activo == true;
    }

    function isAdmin() {
      return isActiveUser()
        && getProfile().data.rol == 'admin';
    }

    function myTrainerKey() {
      return getProfile().data.trainerKey;
    }

    function isPublicTrialLead() {
      return request.auth == null
        && request.resource.data.keys().hasOnly([
          'nombre', 'telefono', 'email',
          'centroId', 'centroNombre',
          'estado', 'fuente', 'medioCaptacion', 'captadorNombre',
          'trainerKey', 'trainerName',
          'objetivo', 'horarioPreferido',
          'tipoPrueba', 'duracionPrueba',
          'notas', 'notaEntrenadorPrueba',
          'createdAt', 'updatedAt',
          'createdByEmail', 'createdByName',
          'updatedByEmail', 'updatedByName',
          'convertido', 'origenPublico', 'origenQR',
          'sourceParam', 'campana',
          'valoracionUnica', 'leadId'
        ])
        && request.resource.data.nombre is string
        && request.resource.data.telefono is string
        && request.resource.data.email is string
        && request.resource.data.centroId is string
        && request.resource.data.centroNombre is string
        && request.resource.data.estado == 'Prueba solicitada'
        && request.resource.data.fuente == 'QR valoración'
        && request.resource.data.trainerKey == ''
        && request.resource.data.trainerName == ''
        && request.resource.data.tipoPrueba == 'Valoración inicial'
        && request.resource.data.duracionPrueba == '45 min'
        && request.resource.data.convertido == false
        && request.resource.data.origenPublico in ['valoracion.html', 'prueba.html']
        && request.resource.data.origenQR == true;
    }

    match /besoulUsers/{email} {
      // Cada usuario autenticado puede leer directamente SU propio perfil.
      // Esto evita depender de isActiveUser() para poder leer el documento
      // que precisamente necesitamos para calcular isActiveUser().
      allow get: if signedIn() && email == request.auth.token.email;

      // Administración puede leer/listar todos los perfiles.
      allow get, list: if isAdmin();

      allow create, update, delete: if isAdmin();
    }

    match /besoulSuite/{docId} {
      // FASE 2 activada (2026-09-17, HARDENING-PRE-BASELINE-v3.2.1): aislamiento de ESCRITURA
      // por trainerKey dentro del documento monolítico besoulSuite/agenda. Candidata validada
      // contra el Firebase Emulator Suite antes de desplegar (rules-tests/, 55+ casos, PT
      // propio ALLOW / PT ajeno DENY por cada uno de los 5 campos anidados por trainer, PT
      // inactivo/auth sin perfil/anónimo DENY, admin ALLOW sin restricción, y el payload REAL
      // que ya envía guardarEstadoNubeAgenda() -- FieldPath, dirigido, nunca documento
      // completo -- sigue permitido sin cambios). Backup exacto de la Rule anterior
      // (idéntica a esta salvo esta sustitución) en
      // firestore-rules-LIVE-pre-FASE2-20260917.rules (fuera del repo), SHA256
      // 669f24fd37a3d5ec6a92f35bea8a413cb2cd647124197e2f84f1710ae322df13.
      //
      // Lectura: SIN CAMBIO -- sigue siendo el documento completo. Firestore no tiene lectura
      // parcial de un documento; ningún ajuste de Rules puede resolver esto mientras
      // clientes/agenda/etc. de TODOS los entrenadores vivan en un único documento. Ver
      // AGENDA_MONOLITHIC_RISK.md para la migración futura (agendaByTrainer/{trainerKey}) que
      // sí lo resolvería -- fuera de alcance de esta fase.
      allow read: if isActiveUser() && docId == 'agenda';
      allow write: if docId == 'agenda' && (
        isAdmin()
        || (isActiveUser()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['clientes','agenda','disponibilidadReservas','historicoClientes','pruebasCRM','notas','actualizadoEn','ultimaActualizacionLocal'])
            && request.resource.data.clientes.diff(resource.data.clientes).affectedKeys().hasOnly([myTrainerKey()])
            && request.resource.data.agenda.diff(resource.data.agenda).affectedKeys().hasOnly([myTrainerKey()])
            && request.resource.data.disponibilidadReservas.diff(resource.data.disponibilidadReservas).affectedKeys().hasOnly([myTrainerKey()])
            && request.resource.data.historicoClientes.diff(resource.data.historicoClientes).affectedKeys().hasOnly([myTrainerKey()])
            && request.resource.data.pruebasCRM.diff(resource.data.pruebasCRM).affectedKeys().hasOnly([myTrainerKey()])
           )
      );
      // "notas" queda deliberadamente FUERA de la comprobación granular por trainerKey: es un
      // mapa plano "trainerKey__clave" (nunca anidado por trainerKey), y Firestore Rules
      // (CEL) no soporta iterar affectedKeys() con un predicado por clave --
      // request.resource.data.notas.diff(...).affectedKeys().all(k, k.matches(...)) fue
      // probado directamente contra el Emulator Suite (rules-tests/run_notas_feasibility_probe.cjs)
      // y falla en tiempo de evaluación con "Function not found error: Name: [all]" -- no es una
      // suposición, es el resultado real del motor de Rules. Aislarlo exigiría migrar "notas" a
      // un mapa anidado por trainerKey (cambio de esquema, fuera de alcance de esta fase) o la
      // migración completa a agendaByTrainer/{trainerKey}. Riesgo residual documentado y
      // aceptado: un PT activo podría, en teoría, escribir la nota de otro PT llamando
      // directamente al SDK -- ningún dato de cliente/agenda/disponibilidad/histórico/pruebasCRM
      // queda expuesto por este hueco.

      // Finanzas sigue reservado solo para administración.
      allow read, write: if isAdmin() && docId == 'finanzas';
    }

    match /besoulLeads/{leadId} {
      // SEC-04 (2026-09-04): CRM hardening real, no solo de UI. crm.html (ROLE-01, ya en main)
      // bloquea el login de cualquier PT antes de revelar app-content -- un PT ya no tiene NINGÚN
      // camino de código legítimo hacia crear/editar leads. Se auditó primero si algo real seguía
      // dependiendo de que un PT escribiera aquí: NO -- el único escritor de create/update es
      // crm.html (admin-only desde ROLE-01), más isPublicTrialLead() para el formulario público
      // sin auth de valoracion.html/prueba.html. Por eso create/update pasan a isAdmin() puro,
      // cerrando el hueco documentado en crm.html (línea ~511-521): antes, un PT con conocimientos
      // técnicos podía seguir creando/editando SUS PROPIOS leads vía llamadas directas a Firestore
      // aunque la UI ya no se lo permitiera.
      //
      // "read" SÍ se mantiene igual (isActiveUser() + trainerKey propio) -- agenda.html
      // (consultaLeadsPermitidosAgenda(), ~línea 1897) SÍ depende de esta lectura en producción
      // hoy: es como un PT ve sus "pruebas" (leads con sesión de valoración agendada) pintadas en
      // su propia Agenda. Ese flujo es real, sigue en uso, y solo necesita leer, nunca escribir.
      allow read: if isAdmin()
        || (isActiveUser() && resource.data.trainerKey == myTrainerKey());

      allow create: if isPublicTrialLead() || isAdmin();

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    match /besoulPublicConfig/{docId} {
      allow get: if docId == 'centros';
      allow list: if false;
      allow create, update, delete: if isActiveUser();
    }

    match /besoulValoracionRegistry/{keyId} {
      allow get: if true;
      allow list: if false;

      allow create: if request.auth == null
        && request.resource.data.kind in ['email', 'phone']
        && request.resource.data.leadId is string
        && request.resource.data.nombre is string
        && request.resource.data.source == 'valoracion_publica';

      allow read, update, delete: if isActiveUser();
    }

    match /besoulPublicClients/{token} {
      allow get: if true;
      allow list: if false;

      // Solo se puede crear el propio (trainerKey del creador) -- salvo ADMIN, que crea en
      // nombre del trainerKey real del cliente al publicar/republicar mientras "ve como" ese PT
      // (publicarReservasPublicasParaTrainer(), primera publicación de un cliente nuevo = create,
      // no update). ASIMETRÍA REAL encontrada en QA (2026-09-17): update/delete de esta colección
      // YA tenían el bypass isAdmin() desde el diseño original; create nunca lo tuvo -- un admin
      // viendo-como un PT con al menos un cliente sin publicar todavía no podía publicarlo (el
      // batch de ESE trainerKey fallaba con permission-denied, aislado por trainerKey gracias al
      // fix de publicación por-lote independiente, así que nunca tumbaba el guardado en sí, pero
      // sí dejaba a ese cliente sin enlace de reservas). Ver rules-tests/run_admin_viewas_repro.cjs.
      allow create: if isAdmin() || (isActiveUser() && request.resource.data.trainerKey == myTrainerKey());

      // Solo el dueño puede actualizar, y no puede reasignarlo a otro trainerKey.
      // CLIENT-09 (2026-09-04, propuesta -- NO desplegada, sin código cliente que la use todavía):
      // tercera rama para que el propio cliente (sin auth -- su identidad ES el token, que ya es
      // el id del documento, mismo modelo de "capability URL" que ya usa "get") pueda sincronizar
      // entre dispositivos qué avisos ha leído. Whitelist estricta a un único campo nuevo
      // (avisosLeidos) -- no puede tocar sesiones, contacto, disponibilidad ni ningún otro dato de
      // su propia ficha ni de nadie más. Ver CLIENT_PORTAL_ARCHITECTURE.md sección 7 para el
      // diseño completo y por qué no se ha conectado portal-cliente.html a esto todavía (misma
      // razón que CLIENT-07: no presentar como funcional algo que depende de una Rule no
      // desplegada).
      allow update: if isAdmin()
        || (isActiveUser()
            && resource.data.trainerKey == myTrainerKey()
            && request.resource.data.trainerKey == resource.data.trainerKey)
        || (request.auth == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avisosLeidos'])
            && request.resource.data.avisosLeidos is list);

      allow delete: if isAdmin();
    }

    match /besoulPublicSchedule/{trainerKey} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isActiveUser();
    }

    match /besoulReservas/{reservaId} {
      // El create original solo validaba la FORMA del payload, no que token/clientId/trainerKey
      // correspondieran realmente entre sí -- cualquiera con un token válido de CUALQUIER cliente
      // de un entrenador podía escribir una reserva suplantando a OTRO cliente del mismo
      // entrenador, porque besoulPublicClients permite "get" público (auditoría FASE 21/Reservas,
      // 2026-09-02). Se añade una comprobación cruzada contra el propio besoulPublicClients/{token}.
      allow create: if request.resource.data.estado == 'pendiente'
        && request.resource.data.token is string
        && request.resource.data.clientId is string
        && request.resource.data.trainerKey is string
        && request.resource.data.fechaISO is string
        && request.resource.data.hora is string
        && request.resource.data.clave is string
        && request.resource.data.duracionMin == 45
        && exists(/databases/$(database)/documents/besoulPublicClients/$(request.resource.data.token))
        && get(/databases/$(database)/documents/besoulPublicClients/$(request.resource.data.token)).data.clientId == request.resource.data.clientId
        && get(/databases/$(database)/documents/besoulPublicClients/$(request.resource.data.token)).data.trainerKey == request.resource.data.trainerKey;

      // Admin ve todas. Un PT solo ve/gestiona reservas asignadas a su trainerKey.
      allow read: if isAdmin()
        || (isActiveUser() && resource.data.trainerKey == myTrainerKey());

      allow update, delete: if isAdmin()
        || (isActiveUser() && resource.data.trainerKey == myTrainerKey());
    }

    // NUEVO — SEC-010: solicitudes de eliminación/baja de cliente.
    match /besoulSolicitudesEliminacion/{solicitudId} {
      // Un PT solo puede crear una solicitud para su propio trainerKey y
      // atribuida a sí mismo. Un admin también puede crearla (p.ej. mientras
      // audita a otro PT con entrenadorVisto), pero solicitadoPor siempre
      // debe ser su propia identidad, nunca la de otro.
      allow create: if request.resource.data.estado == 'pendiente'
        && (!('revisadoPor' in request.resource.data) || request.resource.data.revisadoPor == '')
        && (!('revisadoEn' in request.resource.data) || request.resource.data.revisadoEn == null)
        && (
             (isActiveUser()
               && request.resource.data.trainerKey == myTrainerKey()
               && request.resource.data.solicitadoPor == myTrainerKey())
             || (isAdmin() && request.resource.data.solicitadoPor == myTrainerKey())
           );

      // Admin ve todas. Un PT solo lee las de su propio trainerKey (incluidas
      // las que un admin haya creado en su nombre mientras lo auditaba).
      allow read: if isAdmin()
        || (isActiveUser() && resource.data.trainerKey == myTrainerKey());

      // Solo admin puede resolver, solo desde 'pendiente', y solo puede tocar
      // estado/revisadoPor/revisadoEn/notasAdmin — whitelist estricta para
      // que no pueda alterar clienteId/trainerKey/solicitadoPor/solicitadoEn
      // ni ningún otro campo de identidad.
      allow update: if isAdmin()
        && resource.data.estado == 'pendiente'
        && request.resource.data.estado in ['aprobada', 'rechazada']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'revisadoPor', 'revisadoEn', 'notasAdmin']);

      // Nunca se borran: se conservan como auditoría.
      allow delete: if false;
    }

    // NUEVO — buzón/notificaciones por PT (2026-09-03). Documento independiente,
    // NUNCA dentro de besoulSuite/agenda (evita ensuciar el monolito, y permite
    // seguridad real por trainerKey sin la limitación de aislamiento de lectura
    // que tiene ese documento compartido).
    match /besoulNotifications/{notifId} {
      // Cualquier usuario activo puede crear una notificación dirigida a OTRO
      // trainerKey (p.ej. admin resolviendo una solicitud avisa al PT afectado,
      // o un PT genera un aviso administrativo para sí mismo) -- no hay dato
      // sensible en el esquema (solo texto informativo + referencias a otra
      // entidad), así que permitir el create cross-trainerKey es una decisión
      // deliberada, no un descuido. Se valida la FORMA del payload igualmente.
      allow create: if isActiveUser()
        && request.resource.data.audience in ['trainer', 'admin']
        && (request.resource.data.audience == 'admin' || request.resource.data.trainerKey is string)
        && request.resource.data.type is string
        && request.resource.data.title is string
        && request.resource.data.message is string
        && request.resource.data.read == false;

      // Admin ve todas (incluidas las de otros PT, para supervisión). Un PT
      // solo ve las suyas propias (audience:'trainer' + su trainerKey).
      allow read: if isAdmin()
        || (isActiveUser() && resource.data.audience == 'trainer' && resource.data.trainerKey == myTrainerKey());

      // Marcar leída/no leída: solo el destinatario real o admin, y solo puede
      // tocar read/readAt -- whitelist estricta, igual que en solicitudes de
      // eliminación, para que no se pueda reescribir el contenido del aviso.
      allow update: if (isAdmin() || (isActiveUser() && resource.data.audience == 'trainer' && resource.data.trainerKey == myTrainerKey()))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);

      // Nunca se borran: mismo criterio que solicitudes de eliminación.
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
